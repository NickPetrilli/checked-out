# Get a free API key at: https://aistudio.google.com/apikey
#
# Local dev  → uses VITE_GEMINI_API_KEY directly (key stays in gitignored .env)
# Production → uses GEMINI_API_KEY via the /api/explain server-side proxy (key never in browser bundle)
#              Set GEMINI_API_KEY in your Vercel dashboard environment variables.

VITE_GEMINI_API_KEY=your_api_key_here
GEMINI_API_KEY=your_api_key_here
